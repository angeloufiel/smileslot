# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: transactional email via Resend. Without it, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Harborview Dental <bookings@your-domain.com>"

# Only for `npm run seed:users` (demo accounts). At least 10 characters.
DEMO_PASSWORD=
